{
  "name": "الحكيم-الذكي-الجديد-المستقبل-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc",
    "cap:sync": "cap sync android",
    "cap:build": "npm run build && cap sync android",
    "cap:android": "cap open android",
    "cap:assets": "tsx scripts/generate-assets.ts && capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "1.3.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/ws": "^8.18.2",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.463.0",
    "motion": "^12.38.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
